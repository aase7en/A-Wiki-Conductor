<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.a-sunday.conductor.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/a-conductor-web</string>
        <string>web</string>
        <string>--port</string>
        <string>8756</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/sunday-web.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/sunday-web.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
