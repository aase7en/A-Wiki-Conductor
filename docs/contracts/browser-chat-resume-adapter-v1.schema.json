        "PROPOSE_CONTINUATION",
        "AWAIT_OPERATOR_DECISION"
      ]
    },
    "source_event_ref": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
