    },
    "fake_provider_id": {
      "type": "string",
      "pattern": "^fake-[a-z0-9][a-z0-9._-]{0,62}$",
      "maxLength": 64
    },
    "fake_conversation_locator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
